# AI-RWA Portfolio Optimizer 环境配置

# 区块链配置
WEB3_PROVIDER=https://rpc.hashkeychain.net
PRIVATE_KEY=your_private_key_here
PORTFOLIO_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
SECURITY_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# AI服务配置
AI_MODEL=gpt-4
AI_API_KEY=your_api_key_here

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Chainlink配置
CHAINLINK_USD_FEED=0x0000000000000000000000000000000000000000
PRICE_EXPIRY=3600

# 安全配置
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# 前端配置
REACT_APP_API_URL=http://localhost:8000
REACT_APP_CHAIN_ID=133
REACT_APP_NETWORK_NAME=HSK Chain